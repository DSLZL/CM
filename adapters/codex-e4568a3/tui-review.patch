+
+pub(crate) async fn prepare_cm_review_images(
+    images: Vec<LocalImageAttachment>,
+    remote_urls: Vec<String>,
+) -> Result<crate::bottom_pane::ReviewWork, String> {
+    let permit = IMAGE_PREPARATION.lock().await;
+    tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        let remote_bytes = remote_urls
+            .iter()
+            .try_fold(0_usize, |bytes, url| bytes.checked_add(url.len()))
+            .ok_or("image transport size overflow")?;
+        if remote_bytes > 32 * 1024 * 1024 {
+            return Err("image attachments exceed the 32 MiB transport limit".into());
+        }
+        let files = cm_image_identities(images.iter().map(|image| image.path.clone()))?;
+        let prepared = prepare_images(images, remote_bytes)?;
+        let after = cm_image_identities(files.iter().map(|(path, _)| path.clone()))?;
+        if files != after {
+            return Err("image changed during review preparation".into());
+        }
+        Ok(crate::bottom_pane::ReviewWork {
+            images: prepared,
+            files,
+        })
+    })
+    .await
+    .map_err(|error| format!("image review worker failed: {error}"))?
+}
+
+pub(crate) async fn revalidate_cm_review_images(files: &[(PathBuf, String)]) -> Result<(), String> {
+    let files = files.to_vec();
+    let permit = IMAGE_PREPARATION.lock().await;
+    tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        let current = cm_image_identities(files.iter().map(|(path, _)| path.clone()))?;
+        if current != files {
+            return Err("attachment contents changed; review again".into());
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|error| format!("image validation worker failed: {error}"))?
+}
+
+fn cm_image_identities(
+    paths: impl Iterator<Item = PathBuf>,
+) -> Result<Vec<(PathBuf, String)>, String> {
+    use std::io::Read as _;
+    let mut budget = 32 * 1024 * 1024_usize;
+    paths
+        .map(|path| {
+            let mut file = std::fs::File::open(&path).map_err(|error| error.to_string())?;
+            let before = file.metadata().map_err(|error| error.to_string())?;
+            if !before.is_file() || before.len() > budget as u64 {
+                return Err("review requires bounded regular image files".into());
+            }
+            let mut bytes = Vec::new();
+            file.by_ref()
+                .take(budget as u64 + 1)
+                .read_to_end(&mut bytes)
+                .map_err(|error| error.to_string())?;
+            let after = file.metadata().map_err(|error| error.to_string())?;
+            if bytes.len() > budget
+                || bytes.len() as u64 != before.len()
+                || after.len() != before.len()
+                || after.modified().ok() != before.modified().ok()
+            {
+                return Err("image changed while capturing review".into());
+            }
+            budget -= bytes.len();
+            Ok((path, cm_runtime::tui_review::digest(&bytes)))
+        })
+        .collect()
+}
