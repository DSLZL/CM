+
+fn validate_cm_tool_concurrency_origin(
+    request: &ClientRequest,
+    origin: crate::transport::ConnectionOrigin,
+) -> Result<(), JSONRPCErrorError> {
+    use crate::transport::ConnectionOrigin;
+    let explicit = match request {
+        ClientRequest::TurnStart { params, .. } => params.cm_tool_concurrency.is_some(),
+        ClientRequest::TurnSteer { params, .. } => params.cm_tool_concurrency.is_some(),
+        _ => false,
+    };
+    if explicit
+        && !matches!(
+            origin,
+            ConnectionOrigin::InProcess | ConnectionOrigin::Stdio
+        )
+    {
+        return Err(invalid_request(
+            "cmToolConcurrency requires the local Embedded/stdio backend",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod cm_tool_concurrency_origin_tests {
+    use super::*;
+    use crate::transport::ConnectionOrigin;
+
+    #[test]
+    fn reject_explicit_limits_on_unadvertised_remote_origins() {
+        for method in ["turn/start", "turn/steer"] {
+            for value in [serde_json::Value::Null, serde_json::json!(2)] {
+                let request: ClientRequest = serde_json::from_value(serde_json::json!({
+                    "id": 1, "method": method,
+                    "params": {"threadId": "thread", "expectedTurnId": "turn",
+                        "input": [], "cmToolConcurrency": value}
+                }))
+                .unwrap();
+                for origin in [
+                    ConnectionOrigin::InProcess,
+                    ConnectionOrigin::Stdio,
+                    ConnectionOrigin::WebSocket,
+                    ConnectionOrigin::RemoteControl,
+                ] {
+                    assert_eq!(
+                        validate_cm_tool_concurrency_origin(&request, origin).is_err(),
+                        !value.is_null()
+                            && matches!(
+                                origin,
+                                ConnectionOrigin::WebSocket | ConnectionOrigin::RemoteControl
+                            )
+                    );
+                }
+            }
+        }
+    }
+}
