{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DSLZL/CM/schemas/mod-index.schema.json",
  "title": "CM first-party binary Mod index v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "cm.mod-index.v1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "DSLZL/CM"
        },
        "repository_id": {
          "const": 1430833890
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "repository_id",
        "sha"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "DSLZL/CM-build-linux-x64"
        },
        "repository_id": {
          "const": 1430833977
        },
        "workflow": {
          "const": ".github/workflows/build.yml"
        },
        "workflow_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "repository",
        "repository_id",
        "workflow",
        "workflow_sha",
        "run_id",
        "attempt"
      ]
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,128}$"
          },
          "namespace": {
            "const": "github:1430833890"
          },
          "publisher": {
            "const": "DSLZL/CM"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,128}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cargo_package": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "status": {
            "enum": [
              "available",
              "revoked"
            ]
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
                "maxLength": 512
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "size",
              "sha256"
            ]
          },
          "object_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
                "maxLength": 512
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 262144
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "size",
              "sha256"
            ]
          },
          "bundle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
                "maxLength": 512
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "size",
              "sha256"
            ]
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "sdk",
                  "exact_host",
                  "advanced_hook"
                ]
              },
              "binary": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,128}$"
                  },
                  "entry": {
                    "enum": [
                      "cm_mod_entry_v1",
                      "cm_mod_entry_v2"
                    ]
                  },
                  "glibc_min": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+$",
                    "maxLength": 16
                  },
                  "cpu": {
                    "const": "x86-64"
                  }
                },
                "required": [
                  "path",
                  "size",
                  "sha256",
                  "target",
                  "entry",
                  "glibc_min",
                  "cpu"
                ]
              },
              "compat": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "abi_major": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "abi_minor_min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "abi_minor_max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "host_api_min": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "required_capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]{1,128}$"
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "exact_host": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "build_id": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "executable_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "patch_map_sha256": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "build_id",
                          "executable_sha256",
                          "patch_map_sha256"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "abi_major",
                  "abi_minor_min",
                  "abi_minor_max",
                  "host_api_min",
                  "required_capabilities",
                  "exact_host"
                ]
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9._-]{1,128}$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ]
                },
                "maxItems": 32,
                "minItems": 0
              },
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9._-]{1,128}$"
                },
                "maxItems": 32,
                "minItems": 0
              },
              "state": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "owner": {
                        "type": "string",
                        "pattern": "^[a-z0-9._-]{1,128}$"
                      },
                      "schema": {
                        "type": "string",
                        "pattern": "^[a-z0-9._-]{1,128}$"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "preserve": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "owner",
                      "schema",
                      "version",
                      "preserve"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "binary",
              "compat",
              "dependencies",
              "conflicts",
              "state"
            ]
          },
          "native_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "maxItems": 32,
            "minItems": 0,
            "uniqueItems": true
          },
          "qualification": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
                        "maxLength": 512
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 524288
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "size",
                      "sha256"
                    ]
                  },
                  "bundle": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
                        "maxLength": 512
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2097152
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "size",
                      "sha256"
                    ]
                  }
                },
                "required": [
                  "statement",
                  "bundle"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "record_id",
          "namespace",
          "publisher",
          "id",
          "version",
          "display_name",
          "cargo_package",
          "target",
          "status",
          "archive",
          "object_sha256",
          "manifest_sha256",
          "payload_sha256",
          "receipt",
          "bundle",
          "declarations",
          "native_dependencies",
          "qualification"
        ]
      },
      "maxItems": 1024,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "domain",
    "generated_at",
    "source",
    "signer",
    "policy_sha256",
    "records"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$",
          "maxLength": 512
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "DSLZL/CM"
        },
        "repository_id": {
          "const": 1430833890
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "repository_id",
        "sha"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "DSLZL/CM-build-linux-x64"
        },
        "repository_id": {
          "const": 1430833977
        },
        "workflow": {
          "const": ".github/workflows/build.yml"
        },
        "workflow_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "repository",
        "repository_id",
        "workflow",
        "workflow_sha",
        "run_id",
        "attempt"
      ]
    }
  }
}
