{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CM binary Mod manifest format 3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "sdk",
        "exact_host",
        "advanced_hook"
      ]
    },
    "binary": {
      "$ref": "#/$defs/binary"
    },
    "compat": {
      "$ref": "#/$defs/compat"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "maxItems": 32
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._-]{1,128}$"
      },
      "maxItems": 32
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contribution"
      },
      "maxItems": 128,
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "maxItems": 64
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "required": [
    "format_version",
    "id",
    "version",
    "kind",
    "binary",
    "compat",
    "contributions",
    "provenance"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "compat": {
            "properties": {
              "required_capabilities": { "contains": { "const": "state.files.v1" } }
            },
            "required": ["required_capabilities"]
          }
        },
        "required": ["compat"]
      },
      "then": {
        "required": ["state"],
        "properties": {
          "compat": { "properties": { "abi_major": { "const": 2 } } },
          "state": {
            "properties": {
              "owner": { "not": { "enum": [".", ".."] } },
              "schema": { "not": { "enum": [".", ".."] } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\.so$",
          "minLength": 1,
          "maxLength": 512
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "const": "x86_64-unknown-linux-gnu"
        },
        "entry": {
          "enum": [
            "cm_mod_entry_v1",
            "cm_mod_entry_v2"
          ]
        },
        "glibc_min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "maxLength": 16
        },
        "cpu": {
          "const": "x86-64"
        }
      },
      "required": [
        "path",
        "size",
        "sha256",
        "target",
        "entry",
        "glibc_min",
        "cpu"
      ]
    },
    "exact_host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "patch_map_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "build_id",
        "executable_sha256"
      ]
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abi_major": {
          "enum": [
            1,
            2
          ]
        },
        "abi_minor_min": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "abi_minor_max": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "host_api_min": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "uniqueItems": true
        },
        "exact_host": {
          "$ref": "#/$defs/exact_host"
        }
      },
      "required": [
        "abi_major",
        "abi_minor_min",
        "abi_minor_max",
        "host_api_min",
        "required_capabilities"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,128}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,128}$"
        },
        "kind": {
          "enum": [
            "before",
            "around",
            "replacement",
            "after",
            "legacy_filter",
            "output_limit",
            "lifecycle",
            "tool",
            "context_section",
            "sampling_budget",
            "submit_review",
            "tool_concurrency"
          ]
        },
        "capability": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "order_before": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "order_after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "priority": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "kind",
        "capability",
        "resource"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,128}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,128}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "preserve": {
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "schema",
        "version",
        "preserve"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "release_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "repository",
        "revision",
        "release_notes",
        "license"
      ]
    },
    "static_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,128}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/static_schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/static_schema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type"
      ],
      "description": "CM static subset, not full JSON Schema. Runtime restricts keywords by type, requires properties/additionalProperties=false on objects and items on arrays, and validates enum values, bound consistency, 32 KiB and depth 16."
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "schema": {
          "$ref": "#/$defs/static_schema"
        },
        "defaults": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "schema",
        "defaults"
      ]
    }
  },
  "description": "JSON view of mod.toml; Rust additionally checks SemVer, ABI/entry/minor intervals, Host/system/capability and ownership relationships, canonical paths, digests and all config constraints. Formats 1/2 retain their grammar. advanced_hook remains unsupported."
}
